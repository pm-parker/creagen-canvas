# ===== CreaGen Canvas 配置 =====
# 复制为 .env 后按需修改。必填项缺失时启动即失败并指明变量名。

# --- 基础设施（必填） ---
# PostgreSQL 连接串（compose 内置服务名 db）
DATABASE_URL=postgresql+psycopg://creagen:creagen@db:5432/creagen
# Redis 连接串（arq 队列 + 限流 + 任务事件）
REDIS_URL=redis://redis:6379/0

# --- 安全（必填） ---
# JWT 签名密钥：必须 >=32 字符的强随机值（openssl rand -hex 32），
# 过短或仍含 change-me/please-change 等占位特征时启动直接报错（fail-closed）。
JWT_SECRET=change-me-please-generate-a-random-64-hex
# 渠道密钥加密根：要求同上（>=32 强随机值，占位值拒绝启动）。
# ⚠️ 轮换步骤见 docs/deploy.md「密钥轮换」：先 pg_dump 备份，
# 再用 scripts/reencrypt_channel_keys.py 把已存渠道密钥重加密后才能换值。
ENCRYPTION_KEY=change-me-please-generate-another-64-hex

# --- 端口 ---
# 宿主端口（容器内固定 8080）；与既有服务冲突时改这里，如 18080
API_PORT=8080

# --- 注册策略 ---
# invite=邀请制（默认，推荐公网部署）；open=开放注册
REGISTER_MODE=invite
# 邀请码，逗号分隔；无内置默认码——invite 模式下未配置则注册一律拒绝，
# 必须自行生成，如：openssl rand -hex 8
INVITE_CODES=

# --- 开发调试 ---
# true 时允许在无渠道配置下用内置 FakeProvider 走通任务闭环（仅本地开发/CI）；
# 默认 false，生产/公网部署必须保持 false
ENABLE_FAKE_PROVIDER=false
# 访问令牌有效期（分钟），默认 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080
