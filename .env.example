# ===== CreaGen Canvas 配置 =====
# 复制为 .env 后按需修改。必填项缺失时启动即失败并指明变量名。

# --- 基础设施（必填） ---
# PostgreSQL 连接串（compose 内置服务名 db）
DATABASE_URL=postgresql+psycopg://creagen:creagen@db:5432/creagen
# Redis 连接串（arq 队列 + 限流 + 任务事件）
REDIS_URL=redis://redis:6379/0

# --- 安全（必填） ---
# JWT 签名密钥，>=16 字符。生成：openssl rand -hex 32
JWT_SECRET=change-me-please-generate-a-random-64-hex
# 渠道密钥加密根，>=16 字符。生成：openssl rand -hex 32
# ⚠️ 更换后已保存的渠道 key 将无法解密，请勿随意轮换
ENCRYPTION_KEY=change-me-please-generate-another-64-hex

# --- 端口 ---
# 宿主端口（容器内固定 8080）；与既有服务冲突时改这里，如 18080
API_PORT=8080

# --- 注册策略 ---
# invite=邀请制（默认，推荐公网部署）；open=开放注册
REGISTER_MODE=invite
# 邀请码，逗号分隔；invite 模式下必填至少一个
INVITE_CODES=letmein

# --- 开发调试 ---
# true 时允许在无渠道配置下用内置 FakeProvider 走通任务闭环（仅本地开发/CI）
ENABLE_FAKE_PROVIDER=true
# 访问令牌有效期（分钟），默认 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- 任务队列 ---
# queued 任务收尸阈值（分钟）：入队后超过此时长仍无人接手即标记失败。默认 90
#QUEUED_TASK_TIMEOUT_MIN=90
